# Copy this file to .env.local and fill in your values

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET=your-random-32-char-secret-here

# Google OAuth (for Gmail sync)
# Set up at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# App URL (change for production)
NEXTAUTH_URL=http://localhost:3000

# Database — Neon (PostgreSQL)
# Get your connection string from https://neon.tech → your project → Connection Details
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"
